/*--------------------------------------------------------------
	TEMPLATE FILE FOR REGULAR-SPIKING CORTICAL PYRAMIDAL CELL
	---------------------------------------------------------

	One compartment model and currents derived from:

   Pospischil, M., Toledo-Rodriguez, M., Monier, C., Piwkowska, Z., 
   Bal, T., Fregnac, Y., Markram, H. and Destexhe, A.
   Minimal Hodgkin-Huxley type models for different classes of
   cortical and thalamic neurons.
   Biological Cybernetics 99: 427-441, 2008.

	This model was inspired from:

   McCormick, D.A., Wang, Z. and Huguenard, J. Neurotransmitter 
   control of neocortical neuronal activity and excitability. 
   Cerebral Cortex 3: 387-398, 1993.

	- one compartment model
	- passive
	- HH: Traub
	- IM: m format
	- T-type calcium current
	- L-type calcium current

	Alain Destexhe, CNRS, 2008
	
   *Edited,, 2023

--------------------------------------------------------------*/

begintemplate Fig4		// create a new template object
public soma

create soma[1]

proc init() { local v_potassium, v_sodium

  v_potassium = -100		// potassium reversal potential (mV)
  v_sodium = 50			// sodium reversal potential (mV)

  soma {
	Ra = 100		// geometry 
	nseg = 1
	diam = 56.9		// um
	L = 56.9			// um
	cm = 1.0 // 

	insert pas		// leak current 
	e_pas = -70.4
	g_pas = 3.8e-5		// S/cm^2

	insert hh2		// Hodgin-Huxley INa and IK 
	ek = v_potassium
	ena = v_sodium
	vtraub_hh2 = -57.9	// Resting Vm, BJ was -55
	gnabar_hh2 = 0.058	// S/cm^2
	gkbar_hh2 = 0.0039	// S/cm^2

	insert im		// M current 
	taumax_im = 502 // ms
	gkbar_im = 7.87e-5		// S/cm^2

  }
}
endtemplate Fig4



